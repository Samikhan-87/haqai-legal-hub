FROM qwen2.5:3b

# Set context window size to 2048 tokens to reduce memory usage and speed up processing
PARAMETER num_ctx 2048

# Lower temperature to 0.3 to ensure more factual, deterministic legal responses
PARAMETER temperature 0.3

# Set thread count to match physical CPU cores (4 cores / 8 threads) for optimal CPU inference
PARAMETER num_thread 4

# Limit the maximum number of tokens to predict to prevent runaway generation
PARAMETER num_predict 512
